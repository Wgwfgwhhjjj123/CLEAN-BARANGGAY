# Copy this file to .env beside app.py. Keep .env private.
# Paste the PostgreSQL URI from Supabase > Connect > Session pooler here.
# Use the database password, not an anon key or your Supabase login password.
SUPABASE_DB_URL=
FLASK_SECRET_KEY=replace-with-a-long-random-secret
FLASK_DEBUG=0
PORT=5000

# Set your own admin credentials.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Required to send resident login/password reset verification codes.
BREVO_API_KEY=
MAIL_DEFAULT_SENDER=
MAIL_SENDER_NAME=BasuReport

# Optional: persistent directory for before/after photo files.
# UPLOAD_FOLDER=/path/to/persistent/uploads

# Legacy MySQL configuration is only used when SUPABASE_DB_URL is empty.
# MYSQLHOST=
# MYSQLPORT=3306
# MYSQLUSER=
# MYSQLPASSWORD=
# MYSQLDATABASE=
